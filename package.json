        "next": "16.3.8",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "resend": "^6.30.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^22.20.5",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.8",
        "prisma": "^7.10.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.12",
        "typescript": "^5",
        "vitest": "^5.0.3"
